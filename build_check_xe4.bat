@echo off
rem ==========================================================================
rem  build_check_xe4.bat - verify the MCH_Delphi_Software projects still build
rem  under XE4. Counterpart of the one in Delphi XE Progs, for the GitHub repo.
rem  Run from a normal command prompt; it works from wherever the repo is
rem  cloned. Results go to build_logs_MCH_Delphi_Software\ next to (not
rem  inside) the repo, so the working tree stays clean; summary.txt lists
rem  [PASS] / [FAIL] / [MISSING] for every project. A build log is kept only
rem  for projects that fail. NB: the builds themselves still write .dcu / .exe
rem  output into the working tree.
rem ==========================================================================
setlocal EnableDelayedExpansion

rem --- Settings --------------------------------------------------------------
rem XE4 is BDS 11.0. Adjust if you installed it somewhere else.
set "RSVARS=C:\Program Files (x86)\Embarcadero\RAD Studio\11.0\bin\rsvars.bat"
rem The repo root is the folder this script is in.
for %%I in ("%~dp0.") do set "ROOT=%%~fI"
set "CONFIG=Debug"
set "PLATFORM=Win32"
rem Set to 1 to delete every .dcu under ROOT first. Recommended after a
rem cleanup: a stale .dcu can let a project "build" even though the .pas
rem behind it has been deleted. DCUs are regenerated by the build.
set "CLEAN_DCUS=0"
rem ---------------------------------------------------------------------------

if exist "%RSVARS%" goto :have_rsvars
echo Could not find rsvars.bat at:
echo   !RSVARS!
echo Edit the RSVARS line at the top of this script.
exit /b 1
:have_rsvars
call "%RSVARS%"

for %%I in ("%ROOT%\..") do set "LOGDIR=%%~fI\build_logs_MCH_Delphi_Software"
if exist "%LOGDIR%" del /q "%LOGDIR%\*.log" "%LOGDIR%\summary.txt" >nul 2>&1
if not exist "%LOGDIR%" mkdir "%LOGDIR%"
set "SUMMARY=%LOGDIR%\summary.txt"
> "%SUMMARY%" echo XE4 build check - %DATE% %TIME%  (%CONFIG%/%PLATFORM%)
>>"%SUMMARY%" echo.

if "%CLEAN_DCUS%"=="1" (
    echo Deleting stale .dcu files under "%ROOT%" ...
    del /s /q "%ROOT%\*.dcu" >nul 2>&1
)

set /a N=0, PASS=0, FAIL=0, MISSING=0

call :build "CoCoDM\Distributable\Samples\Comments\TestComments.dpr"
call :build "CoCoDM\Distributable\Samples\Homograph\TestHomographTest.dpr"
call :build "CoCoDM\Source\CocoDelphi.dpr"
call :build "Common\MCHComponents.dproj"
call :build "Common\CoWTree\Test\CoWTreeTest.dpr"
call :build "Common\ExactCover\Test\ExactCoverTest.dpr"
call :build "Common\LockAbstractions\RWWLockTest\RWWLockTest.dpr"
call :build "Common\MemDB2\C_DLL\MemDB2Dll.dpr"
call :build "Common\MemDB2\SQL92Grammar\ParserTest\SQL92ParserTest.dpr"
call :build "Common\MemDB2\Test\MemDB2Test.dpr"
call :build "Common\SoftLexer\Test\LexerTest.dpr"
call :build "Common\SparseMatrix\Test\SparseMatrixTest.dpr"
call :build "Common\StreamingSystem\Test\SSTest.dpr"
call :build "Common\WorkItems\Test\WorkItemTest.dpr"
call :build "Common\WorkItems\Test2\WorkItemTest2.dpr"
call :build "Common\WorkItems\Test3\WITest3.dpr"
call :build "KnowComment\KnowComment\KnowComment.dpr"
call :build "KnowComment\KnowCommentLoader\KnowCommentLoader.dpr"
call :build "MFract\MFract.dpr"
call :build "MMapper\MMapper.dpr"
call :build "NQueens\NQueens.dpr"
call :build "PageMapper\PageMapper.dpr"
call :build "ProjectXPlant\ProjectXPlant.dpr"
call :build "Sudoku\BatchThreadedSolver\SudokuBatch.dpr"
call :build "Sudoku\Sudoku1\Sudoku.dpr"
call :build "Sudoku\Symmetries\CellCount\Order2\Order2.dpr"
call :build "Sudoku\Symmetries\CellCount\Order3\Order3.dpr"
call :build "Sudoku\Symmetries\CellCountMT\Order2\Order2.dpr"
call :build "Sudoku\Symmetries\CellCountMT\Order3\Order3.dpr"
call :build "Sudoku\Symmetries\CellcountMTHash\Order3\Order3.dpr"
call :build "Sudoku\Symmetries\Graph\Order2\Order2.dpr"
call :build "Sudoku\Symmetries\Graph\Order3\Order3.dpr"
call :build "Sudoku\Symmetries\KnownSolnSymmetries\KnownSymmetries.dpr"
call :build "Sudoku\Symmetries\Naive\Order2\Order2.dpr"
call :build "Sudoku\Symmetries\Naive\Order3\Order3.dpr"

>>"%SUMMARY%" echo.
>>"%SUMMARY%" echo Total !N!: !PASS! passed, !FAIL! failed, !MISSING! missing
echo.
type "%SUMMARY%"
echo.
echo Logs: !LOGDIR!
endlocal
exit /b 0

rem --------------------------------------------------------------------------
:build
set /a N+=1
set "SRC=%ROOT%\%~1"
set "LOG=%LOGDIR%\!N!_%~n1.log"
set "PROJ=!SRC!"
if /i "%~x1"==".dpr" set "PROJ=!SRC:~0,-4!.dproj"

echo [!N!] %~1

if not exist "!SRC!" (
    set /a MISSING+=1
    >>"%SUMMARY%" echo [MISSING] %~1   ^(source file not found^)
    goto :eof
)

if exist "!PROJ!" (
    msbuild "!PROJ!" /t:Build /p:Config=%CONFIG% /p:Platform=%PLATFORM% /v:minimal /nologo > "!LOG!" 2>&1
) else (
    rem No .dproj alongside the .dpr - fall back to the command-line compiler
    rem with the usual XE4 unit scope names so unscoped uses clauses resolve.
    pushd "!SRC!\.."
    dcc32 -B -Q -NS"System;System.Win;Winapi;Vcl;Vcl.Imaging;Vcl.Touch;Vcl.Samples;Vcl.Shell;Data;Datasnap;Xml;Web;Soap" "!SRC!" > "!LOG!" 2>&1
    popd
)

if errorlevel 1 (
    set /a FAIL+=1
    >>"%SUMMARY%" echo [FAIL]    %~1   -^> !N!_%~n1.log
) else (
    set /a PASS+=1
    >>"%SUMMARY%" echo [PASS]    %~1
    del "!LOG!" >nul 2>&1
)
goto :eof
