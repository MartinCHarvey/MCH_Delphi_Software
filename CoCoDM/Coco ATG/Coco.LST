  203    
  204  procedure T-->Grammar<--.FixString(var name : AnsiString; len : integer);
  205  var
  206    double, spaces : boolean;
  207    i : integer;
  208  begin
  209    if len = 2 then
  210    begin
  211      SemError(129, '');
  212      exit;
  213    end;
  214    if fTableHandler.IgnoreCase then    // force uppercase 
  215      for i := 2 to len - 1 do
  216        name[i] := UpCase(name[i]);
  217    double := false;
  218    spaces := false;
  219    for i := 2 to len - 1 do   // search for interior " or spaces 
  220    begin
  221      if name[i] = '"' then
  222        double := true;
  223      if name[i] <= ' ' then
  224        spaces := true;
  225    end;
  226    if not double then  // force delimiters to be " quotes 
  227      name[1] := '"'; name[len] := '"';
  228    if spaces then SemError(124, '');
  229  end; {FixString}
  230  
  231  procedure T-->Grammar<--.MatchLiteral(sp : integer);
  232  // store string either as token or as literal 
  233  var
  234    sn, sn1 : CRTSymbolNode;
  235    matchedSp : integer;
  236  begin
  237    fTableHandler.GetSym(sp, sn);
  238    fAutomaton.MatchDFA(sn.name, sp, matchedSp);
  239    if matchedSp <> CRTnoSym then
  240    begin
  241      fTableHandler.GetSym(matchedSp, sn1);
  242      sn1.struct := CRTclassLitToken;
  243      fTableHandler.PutSym(matchedSp, sn1);
  244      sn.struct := CRTlitToken;
  245    end
  246    else
  247      sn.struct := CRTclassToken;
  248    fTableHandler.PutSym(sp, sn);
  249  end; {MatchLiteral}
  250  
  251  procedure T-->Grammar<--.SetCtx(gp : integer);
  252  // set transition code to contextTrans 
  253  var
  254    gn : CRTGraphNode;
  255  begin
  256    while gp > 0 do
  257    begin
  258      fTableHandler.GetNode(gp, gn);
  259      if (gn.typ = CRTchart) or (gn.typ = CRTchrclass) then
  260      begin 
  261        gn.p2 := contextTrans;
  262        fTableHandler.PutNode(gp, gn);
  263      end
  264      else if (gn.typ = CRTopt) or (gn.typ = CRTiter) then
  265        SetCtx(gn.p1)
  266      else if gn.typ = CRTalt then
  267      begin 
  268        SetCtx(gn.p1);
  269        SetCtx(gn.p2);
  270      end;
  271      gp := gn.next;
  272    end;
  273  end; {SetCtx}
  274  
  275  procedure T-->Grammar<--.OptionsModify(Op : TCocoSwitch; AddOption : boolean);
  276  begin
  277    if AddOption then
  278      fOptions.Switches.SwitchSet := fOptions.Switches.SwitchSet + [Op]
  279    else
  280      fOptions.Switches.SwitchSet := fOptions.Switches.SwitchSet - [Op];
  281  end; {OptionsModify}
  282  
  283  function T-->Grammar<--.ValidOptionParams(Op : TCocoSwitch;
  284      OptionState : boolean; ParamList : TStringList) : boolean;
  285  begin
  286    if OptionState then
  287    begin
  288      case Op of
  289        crsGenRegistration : Result := ParamList.Count = 1;
  290        crsUseHashFunctions : Result := ParamList.Count = 2;
  291        else
  292          Result := ParamList.Count = 0;
  293      end; {case}
  294    end
  295    else
  296      Result := ParamList.Count = 0;
  297  end; {ValidOptionParams}
  298  
  299  function T-->Grammar<--.RemoveQuotes(const S : AnsiString) : AnsiString;
  300  begin        
  301    if (S > '') AND (S[1] IN ['"', #39]) then
  302      Result := copy(S,2,Length(S) - 2)
  303    else
  304      Result := S;
  305  end; {RemoveQuotes}
  306  
  307  procedure T-->Grammar<--.SetOption(const OptionName: AnsiString; OptionState : boolean;
  308      ParamList : TStringList);
  309  var
  310    Op : TCocoSwitch;
  311  begin
  312    if length(OptionName) > 1 then
  313      SemError(131,OptionName)
  314    else
  315    begin
  316       case OptionName[1] of 
  317        'A' : Op := crsTraceAutomaton;
  318        'B' : Op := crsAutoIncBuild;
  319        'C' : Op := crsGenTestProgram;
  320        'D' : Op := crsAppendSemiColon;
  321        'E' : Op := crsGenRegistration;
  322        'F' : Op := crsStartFollowSets;
  323        'G' : Op := crsPrintGraph;
  324        'H' : Op := crsUseHashFunctions;
  325        'I' : Op := crsTraceStartSets;
  326        'L' : Op := crsForceListing;
  327        'M' : Op := crsUseRichEdit;
  328        'O' : Op := crsGenCommentEvents;
  329        'R' : Op := crsDfmAsResource;
  330        'S' : Op := crsPrintSymbolTable;
  331        'T' : Op := crsGrammarTestsOnly;
  332        'V' : Op := crsGenVersionInfo;
  333        'W' : Op := crsSpaceAsWhitespace;
  334        'X' : Op := crsPrintXRef;  
  335        'Y' : Op := crsUseSameTextCompare;
  336        'Z' : Op := crsGenConsoleApp;
  337        else
  338        begin
  339          SemError(131, OptionName);
  340          Exit;
  341        end;
  342      end;  // case 
  343      if ValidOptionParams(Op, OptionState, ParamList) then
  344      begin
  345        OptionsModify(Op, OptionState);
  346        if (Op = crsGenRegistration) AND OptionState then
  347          fOptions.AGI.RegistrationPalette := RemoveQuotes(ParamList[0])
  348        else if (Op = crsUseHashFunctions) AND OptionState then
  349        begin
  350          fOptions.AGI.HashPrimary := RemoveQuotes(ParamList[0]); 
  351          fOptions.AGI.HashSecondary := RemoveQuotes(ParamList[1]); 
  352        end; 
  353      end
  354      else
  355        SemError(132,OptionName)
  356    end;
  357  end; {SetOp}         
  358  
