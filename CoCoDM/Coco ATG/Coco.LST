  371  procedure T-->Grammar<--.ClearTokenList;
  372  var
  373    i : integer;
  374  begin
  375    for i := 0 to TokenList.Count - 1 do
  376      TokenList.Objects[i].Free;
  377    TokenList.Clear;
  378  end; {ClearTokenList}
  379  
