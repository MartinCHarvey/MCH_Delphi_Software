[Frames]
Ancestor=$(CocoR)\Frames\CocoBase.pas
Parser=$(CocoR)\Frames\component.frm
Test Project=$(CocoR)\Frames\Test.dpr.frm
Test Form=$(CocoR)\Frames\Test.pas.frm
Test DFM=$(CocoR)\Frames\Test.dfm.frm
Console=$(CocoR)\Frames\Console.dpr.frm

[Output]
Directory=$(CocoR)\Samples\Comments\

[Registration]
Palette=Coco/R

[Messages]
Show Warnings=1
Show LL(1) Start Succ=1

[Hash]
Primary=TinyHash
Secondary=HashSecondaryOne

[Error Msg]
Expected=%D% expected
Invalid=invalid %D%
Not Expected=this symbol not expected in %D%

[Strings]
Version Format='Version:' m.nn 'Release:' r 'Build:' b
Last Build Format=dddddd tt

